// Obi's XI Vault — database schema
// Uses Postgres. Set DATABASE_URL to a Postgres connection string (see README):
// a separate database for your computer and for the live site.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
}

model Product {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  /// Style / collection, e.g. "Metro", "Classic", "New"
  collection  String
  /// "FOOTBALL" | "BASKETBALL"
  sport       String
  /// Price in the smallest currency unit (cents)
  price       Int
  description String
  /// JSON array of size labels, e.g. ["S","M","L"]
  sizes       String
  featured    Boolean        @default(false)
  active      Boolean        @default(true)
  images      ProductImage[]
  orderItems  OrderItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([sport])
  @@index([collection])
  @@index([active])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id              String      @id @default(cuid())
  /// Human friendly number shown to customers, e.g. OXV-10042
  orderNumber     String      @unique
  /// NEW | SENT_TO_SUPPLIER | SHIPPED | COMPLETED | CANCELLED
  status          String      @default("NEW")
  /// PENDING | PAID | FAILED | REFUNDED
  paymentStatus   String      @default("PENDING")
  /// "stripe" or "demo" (simulated payment in local development)
  paymentProvider String      @default("stripe")
  stripeSessionId String?     @unique
  stripePaymentId String?
  currency        String
  subtotal        Int
  shippingCost    Int
  total           Int

  customerName    String
  email           String
  phone           String
  addressLine1    String
  addressLine2    String?
  city            String
  state           String?
  postalCode      String
  country         String
  customerNote    String?

  trackingNumber  String?
  carrier         String?
  adminNotes      String?

  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  paidAt          DateTime?

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Kept nullable so orders survive if a product is later deleted
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Snapshots taken at purchase time
  productName String
  collection  String
  sport       String
  imageUrl    String?
  size        String
  quantity    Int
  unitPrice   Int

  @@index([orderId])
}

model Counter {
  id    String @id
  value Int
}

/// A customer asking us to source a jersey we don't list yet
model JerseyRequest {
  id            String   @id @default(cuid())
  /// Human friendly number shown to customers, e.g. REQ-10042
  requestNumber String   @unique
  /// NEW | SOURCING | QUOTED | FULFILLED | DECLINED
  status        String   @default("NEW")
  name          String
  email         String
  phone         String?
  /// "FOOTBALL" | "BASKETBALL"
  sport         String
  team          String
  /// Season / year / version, e.g. "2024/25 Home" or "1998 retro"
  season        String?
  /// Name and number to print on the back
  player        String?
  size          String
  quantity      Int      @default(1)
  /// Free text, e.g. "up to $120"
  budget        String?
  /// Link to a photo or listing of the jersey
  referenceUrl  String?
  notes         String?
  adminNotes    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
