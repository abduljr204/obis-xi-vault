# ─────────────────────────────────────────────────────────────
# Obi's XI Vault — environment settings
# Copy this file to ".env" and fill in the values.
# ─────────────────────────────────────────────────────────────

# Database: a Postgres connection string (free at https://neon.tech or https://console.prisma.io).
# Use one database for your computer and a different one for the live site (see README).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secret used to sign admin login sessions. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Public address of the site (used for Stripe return links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Payments (Stripe) ─────────────────────────────────────────
# Get these at https://dashboard.stripe.com/test/apikeys
# Leave empty to run in demo mode (payments are simulated, dev only).
STRIPE_SECRET_KEY=""
# From Stripe → Developers → Webhooks (or `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=""

# ── Store settings ───────────────────────────────────────────
# Three-letter currency code supported by Stripe (usd, eur, gbp, sar, aed…)
STORE_CURRENCY="usd"
# Flat shipping fee in the smallest unit (cents). 999 = 9.99
SHIPPING_FLAT_RATE="999"
# Orders at or above this subtotal ship free (cents). 0 disables.
FREE_SHIPPING_THRESHOLD="15000"
# Countries you ship to (2-letter codes, comma separated) — shown at Stripe checkout
SHIPPING_COUNTRIES="US,CA,GB,IE,FR,DE,ES,IT,NL,BE,PT,SE,NO,DK,AU,NZ,SA,AE,QA,KW,BH,OM,NG,GH,ZA"

# ── Customer emails (order confirmation + shipping updates) ──────
# Any SMTP provider works. Leave SMTP_HOST empty to turn emails off.
#   Gmail:  SMTP_HOST="smtp.gmail.com"  SMTP_USER="you@gmail.com"  SMTP_PASS="16-letter app password"
#   Resend: SMTP_HOST="smtp.resend.com" SMTP_USER="resend"         SMTP_PASS="your API key"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Who the email comes from, e.g. "Obi's XI Vault <orders@yourstore.ca>" (Gmail: use your Gmail address)
EMAIL_FROM=""
# Optional: where customer replies go, if not the From address
EMAIL_REPLY_TO=""
# Optional: get an email for every new paid order
ORDER_NOTIFY_EMAIL=""

# ── Product photo storage ────────────────────────────────────
# Leave empty to store uploads in the local "uploads" folder.
# On Vercel, create a Blob store and paste its token here.
BLOB_READ_WRITE_TOKEN=""

# ── Optional: create the first admin automatically during `npm run db:seed`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Optional: your supplier's email. Adds an "Open in email" button on
# each order that pre-fills a message with the order details.
SUPPLIER_EMAIL=""
